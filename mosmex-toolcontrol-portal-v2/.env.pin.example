# MOSMEX PIN OAuth deployment - define via Vercel Project Settings only.
# Google Cloud: create an OAuth client of type "Web application", and set
# Authorized redirect URI to:
# https://mosmex-toolcontrol-oauth-brian-56ae.vercel.app/api/pair/callback
MOSMEX_GOOGLE_WEB_CLIENT_ID=
MOSMEX_GOOGLE_WEB_CLIENT_SECRET=
MOSMEX_PUBLIC_BASE_URL=https://mosmex-toolcontrol-oauth-brian-56ae.vercel.app

# Dedicated Upstash Redis DB used ONLY for PINs (TTL 10 min).
# Do not reuse the PlayDrive Redis namespace without explicit approval.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
